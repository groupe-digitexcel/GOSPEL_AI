FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_CONSTRAINT=/tmp/pip-constraints.txt

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git ffmpeg libsndfile1 build-essential pkg-config \
    libavformat-dev libavcodec-dev libavdevice-dev libavutil-dev \
    libavfilter-dev libswscale-dev libswresample-dev \
    && rm -rf /var/lib/apt/lists/* \
    && printf '%s\n' 'Cython<3.0' > /tmp/pip-constraints.txt

COPY requirements.txt /app/requirements.txt
COPY requirements-voice.txt /app/requirements-voice.txt

RUN python -m pip install --upgrade pip setuptools wheel \
    && pip install -r requirements.txt \
    && pip install -r requirements-voice.txt

COPY . /app

RUN mkdir -p /app/voice_profile /app/models/openvoice_v2 /app/outputs

EXPOSE 8000

CMD ["uvicorn", "main_v3:app", "--host", "0.0.0.0", "--port", "8000"]
