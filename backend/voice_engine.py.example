"""GOSPEL AI voice engine contract.

This file documents the runtime boundary. Keep the owner's reference recordings
outside Git and mount them into the inference runtime.
"""

from pathlib import Path
import os
from uuid import uuid4

ROOT = Path(__file__).resolve().parent
OUT = ROOT / "outputs"
OUT.mkdir(exist_ok=True)

VOICE_EN = Path(os.getenv("GOSPEL_VOICE_EN", ROOT / "voice_profile/english.wav"))
VOICE_FR = Path(os.getenv("GOSPEL_VOICE_FR", ROOT / "voice_profile/french.wav"))

def validate_request(text: str, language: str, speed: float):
    if not text.strip():
        raise RuntimeError("Text is empty.")
    if language not in {"en", "fr"}:
        raise RuntimeError("Language must be en or fr.")
    if not 0.7 <= speed <= 1.3:
        raise RuntimeError("Speed must be between 0.7 and 1.3.")

def reference_for(language: str) -> Path:
    ref = VOICE_EN if language == "en" else VOICE_FR
    if not ref.exists():
        raise RuntimeError(f"Voice reference missing: {ref}")
    return ref

def output_path() -> Path:
    return OUT / f"gospel-ai-{uuid4().hex}.wav"

# The concrete OpenVoice V2 implementation belongs here on the inference host.
# Do not substitute a third-party hosted voice API.
